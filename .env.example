LOG_LEVEL=INFO
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
REPOS_ROOT=/workspace/repos
COLLECTION_NAME=code_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHAT_MODEL=qwen3:8b
TOP_K=8
MAX_CONTEXT_CHUNKS=6
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
INCLUDE_EXTENSIONS=.py,.ts,.tsx,.js,.jsx,.cs,.go,.java,.kt,.md,.yaml,.yml,.json,.sql
EXCLUDE_DIRS=.git,node_modules,dist,build,.next,.venv,venv,bin,obj,target,__pycache__
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
DEFAULT_GITHUB_BRANCH=
